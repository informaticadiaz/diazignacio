---
import '../styles/animations.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ignacio Diaz - Front-end Developer" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-family: system-ui, -apple-system, sans-serif;
		background: #13151a;
		background-size: 224px;
		color: #c0c0c0;
		scroll-behavior: smooth;
	}

	body {
		background: #13151a;
		min-height: 100vh;
	}

	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	::selection {
		background: rgba(136, 58, 234, 0.3);
		color: rgb(224, 204, 250);
	}

	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: rgba(19, 21, 26, 0.5);
	}

	::-webkit-scrollbar-thumb {
		background: rgba(136, 58, 234, 0.3);
		border-radius: 5px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: rgba(136, 58, 234, 0.5);
	}
</style>
